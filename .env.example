# Default: SQLite file committed to the repo at data/grocery.db, refreshed
# weekly by .github/workflows/scrape-weekly.yml. Leave unset to use it.
# DATABASE_URL=sqlite:///./data/grocery.db

# Alternative: local Postgres via `docker compose -f infra/compose.yaml up -d`
# DATABASE_URL=postgresql+psycopg2://grocery:grocery@localhost:5432/grocery

OPENAI_API_KEY=sk-REPLACE_ME
REPO_TYPE=db